# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Build output
build/
dist/

# Local runtime data: the child's own sessions, models, preferences.
# Kept on disk, never published.
/results/
/stats/
/models/
/prefs.json
almathus_capture.wav
*.log

# Working screenshots. The two the README shows live in assets/screenshots/
# and are tracked, so this is anchored to the top-level directory.
/screenshots/

# Private notes, packaging plans and the release runbook: development material,
# never published. The public repo carries the licence facts in README.md and
# NOTICE instead.
/docs/

# Local-only asset notes. The published credits live in
# assets/sounds/CREDITS.md and assets/flags/README.md, which are tracked.
/assets/README.md

# Retired assets, kept on disk for reference and never tracked.
/archived/

# Local macOS dev launcher (see main.relaunch_as_app_bundle): keeps a bare
# Tk run from registering under the editor bundle. Never part of a release.
/Almathus.app/

# Developer-only material: not part of the game or its wheel.
/AGENTS.md
.claude/
/tools/

# macOS
.DS_Store
._*

# Signing material — must never be committed
*.p12
*.pfx
*.cer
*.mobileprovision
*.key
.env
